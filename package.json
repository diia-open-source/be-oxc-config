{
    "name": "@diia-inhouse/oxc-config",
    "version": "6.0.0",
    "description": "OXC toolchain configs for Diia services: oxlint, oxfmt, oxc transformer",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-oxc-config",
    "bin": {
        "diia-dev": "./bin/dev.mjs"
    },
    "files": [
        "dist",
        "oxlint/plugins",
        "bin"
    ],
    "type": "module",
    "exports": {
        "./oxlint": "./dist/oxlint/config.js",
        "./oxfmt": "./dist/oxfmt.config.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "vitest run",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r oxlint/plugins dist/oxlint/",
        "prepare": "npm run build",
        "lint": "oxlint && oxfmt --check",
        "lint-fix": "oxlint --fix && oxfmt",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "semantic-release": "semantic-release"
    },
    "dependencies": {
        "@boundaries/eslint-plugin": "7.2.1",
        "@diia-inhouse/eslint-plugin": "1.9.13",
        "@stylistic/eslint-plugin": "5.10.0",
        "eslint-import-resolver-oxc": "0.15.0",
        "eslint-plugin-regexp": "3.3.1",
        "eslint-plugin-security": "4.2.0",
        "tsx": "4.23.15"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.2.2",
        "@typescript-eslint/parser": "8.71.1",
        "@typescript-eslint/rule-tester": "8.71.1",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "lockfile-lint": "5.0.1",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "semantic-release": "25.0.9",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "oxfmt": ">= 0.72.0",
        "oxlint": ">= 1.87.0",
        "oxlint-tsgolint": ">= 7.0.0"
    },
    "overrides": {
        "handlebars": "4.7.10"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
