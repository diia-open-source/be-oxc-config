{
    "name": "@diia-inhouse/oxc-config",
    "version": "6.2.2",
    "description": "OXC toolchain configs for Diia services: oxlint, oxfmt, oxc transformer",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-oxc-config",
    "bin": {
        "diia-dev": "./bin/dev.mjs"
    },
    "files": [
        "dist",
        "oxlint/plugins",
        "bin"
    ],
    "type": "module",
    "exports": {
        "./oxlint": "./dist/oxlint/config.js",
        "./oxfmt": "./dist/oxfmt.config.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "tsc --project tests/tsconfig.json --noEmit && vitest run",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r oxlint/plugins dist/oxlint/",
        "prepare": "npm run build",
        "lint": "oxlint && oxfmt --check",
        "lint-fix": "oxlint --fix && oxfmt",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "semantic-release": "semantic-release"
    },
    "dependencies": {
        "@boundaries/eslint-plugin": "7.4.4",
        "@stylistic/eslint-plugin": "6.0.1",
        "eslint-import-resolver-oxc": "0.15.0",
        "eslint-plugin-regexp": "3.3.3",
        "eslint-plugin-security": "4.2.1",
        "tsx": "4.23.15"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.5.0",
        "@types/node": "26.6.6",
        "@typescript-eslint/rule-tester": "8.73.0",
        "@vitest/coverage-v8": "5.1.1",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "semantic-release": "25.0.9",
        "typescript": "5.9.3",
        "vitest": "5.1.1"
    },
    "peerDependencies": {
        "oxfmt": ">= 0.72.0",
        "oxlint": ">= 1.87.0",
        "oxlint-tsgolint": ">= 7.0.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
