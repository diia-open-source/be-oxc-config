{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["oxlint/config.ts", "oxfmt.config.ts"]
}
